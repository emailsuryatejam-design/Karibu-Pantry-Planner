# Karibu Pantry Planner — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Database (Hostinger)
DB_HOST=auth-db1899.hstgr.io
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# SMTP — Gmail (use an App Password, not your main password)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=jambo@karibucamps.com
MAIL_SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Email identity
MAIL_FROM=jambo@karibucamps.com
MAIL_FROM_NAME=Karibu Pantry Planner

# VAPID keys for push notifications (generate with vapid-keys.php)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@karibucamps.com

# App URL (no trailing slash)
APP_URL=https://your-domain.hostingersite.com
